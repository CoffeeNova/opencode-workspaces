{
  "name": "opencode-workspaces",
  "version": "0.1.0",
  "description": "Session-scoped multi-root workspaces for the OpenCode V2 terminal UI",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": ["dist", "README.md"],
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "peerDependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "1.9.15"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "bun run scripts/start.ts",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "prepack": "bun run build",
    "pack": "bun run scripts/pack.ts",
    "bun-typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "check:workspaces": "bun run scripts/check-workspaces.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.30",
    "zod": "4.1.8",
    "ignore": "7.0.12"
  },
  "devDependencies": {
    "@opencode/client": "2.0.30",
    "@opencode/schema": "2.0.30",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.4.3",
    "@xterm/headless": "5.5.0",
    "prettier": "3.9.10",
    "solid-js": "1.9.15",
    "typescript": "5.8.3"
  }
}
