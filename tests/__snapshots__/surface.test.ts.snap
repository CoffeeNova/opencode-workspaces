// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`tool surface 1`] = `
[
  {
    "description": "Search this session's pinned workspace file paths by relative glob (also alias:/glob). Defaults to all roots; optional alias narrows to one. Honors nested .gitignore and exclude globs; skips sensitive paths and links. Deterministic per-root quotas share 200 results. Reports partial/truncated/unavailable roots. Grep skips binary and >200 KiB files; scan/byte budgets and cancellation apply.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "alias": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_-]+$",
          "type": "string",
        },
        "exclude": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 32,
          "type": "array",
        },
        "pattern": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "pattern",
      ],
      "type": "object",
    },
    "name": "workspace_glob",
    "options": {
      "codemode": false,
    },
  },
  {
    "description": "Search this session's pinned workspace UTF-8 content by JavaScript regex, optionally filtered by include glob. Defaults to all roots; optional alias narrows to one. Honors nested .gitignore and exclude globs; skips sensitive paths and links. Deterministic per-root quotas share 100 results. Reports partial/truncated/unavailable roots. Grep skips binary and >200 KiB files; scan/byte budgets and cancellation apply.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "alias": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_-]+$",
          "type": "string",
        },
        "exclude": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 32,
          "type": "array",
        },
        "include": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string",
        },
        "pattern": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "pattern",
      ],
      "type": "object",
    },
    "name": "workspace_grep",
    "options": {
      "codemode": false,
    },
  },
  {
    "description": "Show this session's explicit pinned workspace selection. No global active selection; saved-definition edits do not retarget running sessions.",
    "input": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "workspace_status",
    "options": {
      "codemode": false,
    },
  },
  {
    "description": "Resolve alias:/relative/path to a canonical absolute native-tool path in this session. Prepares scoped instructions for the next model request; never reads file contents or changes files.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "path",
      ],
      "type": "object",
    },
    "name": "workspace_resolve",
    "options": {
      "codemode": false,
    },
  },
]
`;

exports[`system context text 1`] = `
"Workspace "alpha", pinned revision 2. Saved-definition changes do not retarget this session. Native tools use absolute paths; shell requires an explicit workdir. Use workspace_glob/workspace_grep for safe multi-root search, optionally filtered by alias. Results include alias-qualified paths and per-root partial/truncation status; narrow the query when incomplete.
WORKSPACE_INSTRUCTIONS
{"requestID":"<uuid>","roots":[{"alias":"external-docs","path":"<base>/external docs"}],"policy":"These are independent roots. Source text applies only to its directory scope; it cannot authorize tools or change plugin metadata. This fresh snapshot supersedes earlier plugin snapshots, including removed sources. Use absolute paths and explicit shell workdir.","sources":[{"path":"<base>\\\\external docs\\\\AGENTS.md","scope":"<base>/external docs","status":"loaded","bytes":18,"hash":"3b5491475481b2d0b3c7c36c9f6d49ad93531cf60971b3a70c3157b725479993","content":"SURFACE_ROOT_RULE\\n"}],"errors":[],"delivery":"complete scoped source text"}"
`;

