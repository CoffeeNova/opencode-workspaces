exports[`error messages 1`] = `
{
  "addRoot with a duplicate explicit alias": {
    "code": "ALIAS_EXISTS",
    "message": "ALIAS_EXISTS: That alias already belongs to another folder",
    "tag": null,
  },
  "attach on a started session": {
    "code": "SESSION_STARTED",
    "message": "SESSION_STARTED: This session has started or cannot be confirmed empty. Open the workspace in a new session instead",
    "tag": null,
  },
  "change with a stale revision": {
    "code": "REVISION_CONFLICT",
    "message": "REVISION_CONFLICT: Workspace data changed; reopen the menu",
    "tag": null,
  },
  "create with a duplicate name": {
    "code": "WORKSPACE_EXISTS",
    "message": "WORKSPACE_EXISTS: That workspace name already exists",
    "tag": null,
  },
  "native glob over a bound root": {
    "code": null,
    "message": "USE_WORKSPACE_SEARCH: Use workspace_glob or workspace_grep for bound roots; native search cannot enforce workspace ignore and sensitive-path policy",
    "tag": "Tool.Error",
  },
  "native read with a relative path": {
    "code": null,
    "message": "INVALID_PATH: Native file tools require absolute paths; use workspace_resolve for aliases",
    "tag": "Tool.Error",
  },
  "reused request ID with a different action": {
    "code": "REQUEST_CONFLICT",
    "message": "REQUEST_CONFLICT: Request ID was reused for another operation",
    "tag": null,
  },
  "workspace_resolve with an unknown alias": {
    "code": null,
    "message": "INVALID_PATH: use a registered alias:/relative/path",
    "tag": "Tool.Error",
  },
  "workspace_status on a passive session": {
    "code": null,
    "message": "NO_WORKSPACE: Explicitly select a workspace through /workspace in an empty or new session",
    "tag": "Tool.Error",
  },
}
`;
